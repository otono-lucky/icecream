# Copy to .dev.vars for `wrangler dev`. Never commit .dev.vars.
ENVIRONMENT=development
BILLING_PROVIDER=fake
EMAIL_PROVIDER=console
# To send real emails locally, set EMAIL_PROVIDER=smtp and fill these in.
# Gmail: turn on 2-Step Verification, then create an app password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_NAME=icecream
EMAIL_FROM_ADDRESS=
CORS_ORIGINS=http://localhost:8081,http://localhost:5173
OTP_PEPPER=dev-only-pepper-change-me
# With EMAIL_PROVIDER=console (codes only printed to the log), every sign-in code is this outside production,
# so you can sign in without reading logs. With EMAIL_PROVIDER=smtp, codes are emailed and always random.
OTP_FIXED_CODE=123456
