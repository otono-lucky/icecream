{
  "name": "icecream-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types src/worker-configuration.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply icecream-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply icecream-db --remote",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "admin": "node scripts/admin.mjs",
    "seed:local": "node scripts/seed-local.mjs"
  },
  "dependencies": {
    "hono": "^4.13.9",
    "worker-mailer": "^1.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.2.7",
    "@vitest/runner": "^4.1.11",
    "@vitest/snapshot": "^4.1.11",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.140.0"
  }
}
